# 根目錄 .env（docker-compose 使用）。後端完整變數見 backend/.env.example。
# ⚠️ 切勿把真實機密提交或落地；生產請用 secret manager 注入。

# PostgreSQL
POSTGRES_DB=autodrive
POSTGRES_USER=autodrive
POSTGRES_PASSWORD=CHANGE_ME

# Backend（SQLAlchemy async DSN，指向 docker-compose 的 db 服務）
DATABASE_URL=postgresql+asyncpg://autodrive:CHANGE_ME@db:5432/autodrive

# Redis
REDIS_URL=redis://redis:6379

# ── 後端必填（非 DEBUG 模式缺少會 fail-fast）──
DEBUG=false
SECRET_KEY=                 # openssl rand -hex 32
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Sui / Agent ──
SUI_NODE_URL=https://fullnode.testnet.sui.io:443
SUI_NETWORK=testnet
# 以下 ID 全部由 scripts/ops/deploy_and_init.sh 的輸出取得（重新部署後整組一起換）
CONTRACT_PACKAGE_ID=
USER_REGISTRY_ID=
VEHICLE_REGISTRY_ID=
DID_REGISTRY_ID=
CREDENTIAL_REGISTRY_ID=
TRUSTED_ISSUERS_ID=
REFUND_POOL_ID=
# 平台持有的能力物件（owned by 部署者錢包；換錢包必須重新部署才會重 mint）
REFUND_CAPABILITY_ID=
CREDENTIAL_ADMIN_CAP_ID=
RATING_ADMIN_CAP_ID=
ARBITER_CAP_ID=
# 平台收費 / Agent 簽章錢包（須與 mobile/lib/config/app_config.dart 的 platformAddress 一致）
PLATFORM_WALLET_ADDRESS=
OPERATOR_PRIVATE_KEY=       # 上述錢包的私鑰（suiprivkey1…），勿落地檔案、勿入庫
MOCK_MODE=false

# ── Walrus 去中心化存儲 ──
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# API Keys（選填）
GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=
