/// 本地開發配置示例
///
/// 複製這個文件為 app_config.local.dart 並修改你的 IP 地址
///
/// 步驟：
/// 1. 複製文件：cp app_config.local.dart.example app_config.local.dart
/// 2. 查看 Mac IP：在終端執行 ifconfig | grep "inet "
/// 3. 修改下面的 IP 地址為你的 Mac IP
/// 4. 重新運行 Flutter app

// 將下面的 IP 改為你的 Mac 實際 IP
String get localBackendUrl => 'http://192.168.x.x:8000/api/v1';

// 常見 IP 範圍：
// - 192.168.0.x
// - 192.168.1.x
// - 192.168.50.x
// - 10.0.0.x

// zkLogin（Google OAuth）本地覆蓋值。向 Google Cloud Console 申請 OAuth client 後填入。
// 留佔位符即可編譯；實際登入需填真值（見 docs/ZKLOGIN_SETUP.md）。
// 注意：這些 getter 必須與 app_config.local.dart 一致，否則 app_config.dart 參照會編譯失敗。
String get localGoogleOAuthClientId => 'YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com';
String get localGoogleOAuthRedirectUrl => 'com.example.projectDapp:/oauth2redirect';
